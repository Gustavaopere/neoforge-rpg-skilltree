    {
      "entry_id": "BIOME:betternether:bone_reef",
      "title": "Bone Reef",
      "summary": {
        "text": "Bone Reef é um bioma do Nether registrado por BetterNether: New Dawn com o ID betternether:bone_reef. O título preserva exatamente o valor fornecido pelo asset pt-BR do provider.",
        "sources": [
          {"type": "RUNTIME", "ref": "betternether:biome/betternether:bone_reef"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterNether-New-Dawn/blob/543127cab48b1ecb0017fee4222af25e0583e185/src/main/java/org/betterx/betternether/registry/NetherBiomes.java"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterNether-New-Dawn/blob/543127cab48b1ecb0017fee4222af25e0583e185/src/main/resources/assets/betternether/lang/pt_br.json"}
        ]
      },
      "sections": {
        "worldgen": {
          "text": "O provider oficial faz bootstrap deste ID com `BoneReef`, pelo pipeline de `NetherBiomeBuilder`, e o inclui em `registerBiomeToggles()`. A classe do bioma acrescenta features próprias, incluindo elementos ósseos e vegetação do provider, sem que a ficha congele chance, densidade ou frequência numérica.",
          "sources": [
            {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterNether-New-Dawn/blob/543127cab48b1ecb0017fee4222af25e0583e185/src/main/java/org/betterx/datagen/betternether/worldgen/NetherBiomesProvider.java"},
            {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterNether-New-Dawn/blob/543127cab48b1ecb0017fee4222af25e0583e185/src/main/java/org/betterx/betternether/world/biomes/BoneReef.java"},
            {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterNether-New-Dawn/blob/543127cab48b1ecb0017fee4222af25e0583e185/src/main/java/org/betterx/betternether/registry/NetherBiomes.java"}
          ]
        }
      },
      "references": [],
      "review_status": "REVIEWED",
      "availability": "RUNTIME"
    },
