      "entry_id": "BIOME:biomeswevegone:temperate_grove",
      "title": "Bosque Temperado",
      "summary": {
        "text": "Bosque Temperado é um bioma do Overworld registrado por Oh The Biomes We've Gone com o ID biomeswevegone:temperate_grove.",
        "sources": [
          {"type": "RUNTIME", "ref": "biomeswevegone:biome/biomeswevegone:temperate_grove"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/resources/assets/biomeswevegone/lang/pt_br.json"}
        ]
      },
      "sections": {"worldgen": {"text": "O provider classifica este bioma como planície com vegetação esparsa e o inclui nas tags vanilla de vila de planície e posto de saqueadores. Essas tags expressam elegibilidade estrutural, não geração garantida.", "sources": [{"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"}]}},
      "references": [], "review_status": "REVIEWED", "availability": "RUNTIME"
    },
    {
      "entry_id": "BIOME:biomeswevegone:weeping_witch_forest",
      "title": "Floresta das Bruxas Choronas",
      "summary": {
        "text": "Floresta das Bruxas Choronas é um bioma do Overworld registrado por Oh The Biomes We've Gone com o ID biomeswevegone:weeping_witch_forest.",
        "sources": [
          {"type": "RUNTIME", "ref": "biomeswevegone:biome/biomeswevegone:weeping_witch_forest"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/resources/assets/biomeswevegone/lang/pt_br.json"}
        ]
      },
      "sections": {"worldgen": {"text": "O provider classifica este bioma como floresta mágica com vegetação densa e o inclui nas tags de mansão da floresta e de Vila de Salem do BWG. Essas tags indicam elegibilidade de worldgen, não presença garantida.", "sources": [{"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"}]}},
      "references": [], "review_status": "REVIEWED", "availability": "RUNTIME"
    },
    {
      "entry_id": "BIOME:biomeswevegone:white_mangrove_marshes",
      "title": "Mangue Branco",
      "summary": {
        "text": "Mangue Branco é um bioma do Overworld registrado por Oh The Biomes We've Gone com o ID biomeswevegone:white_mangrove_marshes.",
        "sources": [
          {"type": "RUNTIME", "ref": "biomeswevegone:biome/biomeswevegone:white_mangrove_marshes"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/resources/assets/biomeswevegone/lang/pt_br.json"}
        ]
      },
      "sections": {"worldgen": {"text": "O registro oficial do provider classifica este bioma como pântano. Ocorrência, distribuição e frequência permanecem definidas pelo worldgen e pelas configurações ativas, sem valores universais fixados aqui.", "sources": [{"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"}]}},
      "references": [], "review_status": "REVIEWED", "availability": "RUNTIME"
    },
    {
      "entry_id": "BIOME:biomeswevegone:windswept_desert",
      "title": "Deserto Ventoso",
      "summary": {
        "text": "Deserto Ventoso é um bioma do Overworld registrado por Oh The Biomes We've Gone com o ID biomeswevegone:windswept_desert.",
        "sources": [
          {"type": "RUNTIME", "ref": "biomeswevegone:biome/biomeswevegone:windswept_desert"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/resources/assets/biomeswevegone/lang/pt_br.json"}
        ]
      },
      "sections": {"worldgen": {"text": "O provider classifica este bioma como deserto arenoso e associa-o à categoria interna de terreno varrido pelo vento. A ficha preserva essa taxonomia sem inferir intensidade, geometria, altura ou frequência numéricas.", "sources": [{"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"}]}},
      "references": [], "review_status": "REVIEWED", "availability": "RUNTIME"
    },
