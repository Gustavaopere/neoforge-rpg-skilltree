      },
      "sections": {
        "worldgen": {
          "text": "O provider registra este bioma no conjunto de cavernas especiais do mod e o integra ao Overworld; a ocorrência exata continua dependente do worldgen corrente.",
          "sources": [
            {"type": "OFFICIAL_CODE", "ref": "https://github.com/AlexModGuy/AlexsCaves/blob/4718f4287c65b810aecb211789b45f54d405a94d/src/main/java/com/github/alexmodguy/alexscaves/server/level/biome/ACBiomeRegistry.java"}
          ]
        },
        "atmosfera": {
          "text": "Cavernas Desoladas participa do sistema de atmosfera específica dos biomas de Alex's Caves e possui ajustes próprios de neblina e cor de iluminação no código do provider.",
          "sources": [
            {"type": "VERIFIED_COMMUNITY", "ref": "https://www.curseforge.com/minecraft/mc-mods/alexs-caves-neo"},
