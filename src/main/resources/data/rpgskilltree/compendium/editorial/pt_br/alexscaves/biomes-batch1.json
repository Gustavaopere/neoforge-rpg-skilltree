    {
      "entry_id": "BIOME:alexscaves:abyssal_chasm",
      "title": "Fendas Abissais",
      "summary": {
        "text": "Fendas Abissais é um dos seis biomas cavernosos raros de Alex's Caves Neo, localizado nas profundezas do Overworld e identificado no runtime pelo ID alexscaves:abyssal_chasm.",
        "sources": [
          {"type": "RUNTIME", "ref": "alexscaves:biome/alexscaves:abyssal_chasm"},
          {"type": "VERIFIED_COMMUNITY", "ref": "https://www.curseforge.com/minecraft/mc-mods/alexs-caves-neo"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/AlexModGuy/AlexsCaves/blob/4718f4287c65b810aecb211789b45f54d405a94d/src/main/java/com/github/alexmodguy/alexscaves/server/level/biome/ACBiomeRegistry.java"}
        ]
      },
      "sections": {
        "worldgen": {
          "text": "O registro do provider inclui este bioma no conjunto de cavernas de Alex's Caves e o associa ao Overworld. Frequência, posição e distribuição concreta permanecem responsabilidade do worldgen e dos datapacks ativos.",
          "sources": [
            {"type": "OFFICIAL_CODE", "ref": "https://github.com/AlexModGuy/AlexsCaves/blob/4718f4287c65b810aecb211789b45f54d405a94d/src/main/java/com/github/alexmodguy/alexscaves/server/level/biome/ACBiomeRegistry.java"}
          ]
        },
        "atmosfera": {
          "text": "A identidade visual do bioma inclui tratamento próprio de neblina, neblina subaquática e iluminação. O Compêndio não congela em prosa os valores numéricos dessas renderizações.",
          "sources": [
            {"type": "OFFICIAL_CODE", "ref": "https://github.com/AlexModGuy/AlexsCaves/blob/4718f4287c65b810aecb211789b45f54d405a94d/src/main/java/com/github/alexmodguy/alexscaves/server/level/biome/ACBiomeRegistry.java"},
            {"type": "VERIFIED_COMMUNITY", "ref": "https://www.curseforge.com/minecraft/mc-mods/alexs-caves-neo"}
          ]
        }
      },
      "references": [],
      "review_status": "REVIEWED",
      "availability": "RUNTIME"
    },
    {
      "entry_id": "BIOME:alexscaves:candy_cavity",
      "title": "Candy Cavity",
      "summary": {
        "text": "Candy Cavity é um dos seis biomas cavernosos raros de Alex's Caves Neo, com conteúdo próprio de blocos, itens, criaturas e mecânicas e ID runtime alexscaves:candy_cavity.",
        "sources": [
          {"type": "RUNTIME", "ref": "alexscaves:biome/alexscaves:candy_cavity"},
          {"type": "VERIFIED_COMMUNITY", "ref": "https://www.curseforge.com/minecraft/mc-mods/alexs-caves-neo"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/AlexModGuy/AlexsCaves/blob/4718f4287c65b810aecb211789b45f54d405a94d/src/main/java/com/github/alexmodguy/alexscaves/server/level/biome/ACBiomeRegistry.java"}
        ]
      },
      "sections": {
        "worldgen": {
          "text": "O registry do provider inclui Candy Cavity no conjunto de biomas cavernosos e o adiciona ao Overworld. A ficha evita transformar raridade editorial em probabilidade ou coordenada fixa de geração.",
          "sources": [
            {"type": "OFFICIAL_CODE", "ref": "https://github.com/AlexModGuy/AlexsCaves/blob/4718f4287c65b810aecb211789b45f54d405a94d/src/main/java/com/github/alexmodguy/alexscaves/server/level/biome/ACBiomeRegistry.java"}
          ]
        },
        "atmosfera": {
          "text": "O provider aplica ambientação própria aos biomas de caverna, incluindo partículas, neblina, brilho e cor de luz; Candy Cavity também participa dos ajustes específicos de iluminação e neblina definidos pelo código do bioma.",
          "sources": [
            {"type": "VERIFIED_COMMUNITY", "ref": "https://www.curseforge.com/minecraft/mc-mods/alexs-caves-neo"},
            {"type": "OFFICIAL_CODE", "ref": "https://github.com/AlexModGuy/AlexsCaves/blob/4718f4287c65b810aecb211789b45f54d405a94d/src/main/java/com/github/alexmodguy/alexscaves/server/level/biome/ACBiomeRegistry.java"}
          ]
        }
      },
      "references": [],
      "review_status": "REVIEWED",
      "availability": "RUNTIME"
    },
