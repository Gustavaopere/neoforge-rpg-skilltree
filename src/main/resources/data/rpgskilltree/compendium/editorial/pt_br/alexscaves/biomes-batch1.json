        ]
      },
      "sections": {
        "worldgen": {
          "text": "O registry do provider inclui Cavernas Magnéticas no conjunto de biomas cavernosos e o integra ao Overworld. O Compêndio não fixa frequência nem posição universal de encontro.",
          "sources": [
            {"type": "OFFICIAL_CODE", "ref": "https://github.com/AlexModGuy/AlexsCaves/blob/4718f4287c65b810aecb211789b45f54d405a94d/src/main/java/com/github/alexmodguy/alexscaves/server/level/biome/ACBiomeRegistry.java"}
          ]
        },
        "exploracao": {
