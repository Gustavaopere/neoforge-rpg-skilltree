        ]
      },
      "sections": {"worldgen": {"text": "O provider classifica este bioma como ermo seco e pico e o associa à categoria interna de arco de rocha vermelha. A ficha preserva essa taxonomia sem transformar essas categorias em altura, geometria ou frequência fixas.", "sources": [{"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"}]}},
      "references": [], "review_status": "REVIEWED", "availability": "RUNTIME"
    },
