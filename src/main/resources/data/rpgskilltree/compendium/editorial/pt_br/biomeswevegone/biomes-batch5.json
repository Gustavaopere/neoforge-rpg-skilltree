      "entry_id": "BIOME:biomeswevegone:rugged_badlands",
      "title": "Ermo Acidentado",
      "summary": {
        "text": "Ermo Acidentado é um bioma do Overworld registrado por Oh The Biomes We've Gone com o ID biomeswevegone:rugged_badlands.",
        "sources": [
          {"type": "RUNTIME", "ref": "biomeswevegone:biome/biomeswevegone:rugged_badlands"},
