      "entry_id": "BIOME:biomeswevegone:rose_fields",
      "title": "Campo de Rosas",
      "summary": {
        "text": "Campo de Rosas é um bioma do Overworld registrado por Oh The Biomes We've Gone com o ID biomeswevegone:rose_fields.",
