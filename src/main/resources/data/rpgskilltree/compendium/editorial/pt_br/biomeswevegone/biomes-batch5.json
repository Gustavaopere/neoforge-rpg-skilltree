      "entry_id": "BIOME:biomeswevegone:red_rock_valley",
      "title": "Vale da Rocha Vermelha",
      "summary": {
        "text": "Vale da Rocha Vermelha é um bioma do Overworld registrado por Oh The Biomes We've Gone com o ID biomeswevegone:red_rock_valley.",
        "sources": [
          {"type": "RUNTIME", "ref": "biomeswevegone:biome/biomeswevegone:red_rock_valley"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/resources/assets/biomeswevegone/lang/pt_br.json"}
        ]
      },
      "sections": {"worldgen": {"text": "O provider classifica este bioma como ermo seco, associa-o à categoria interna de arco de rocha vermelha e o inclui na tag estrutural própria do BWG para a Vila de Rocha Vermelha. A tag indica elegibilidade de worldgen, não presença garantida.", "sources": [{"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"}]}},
      "references": [], "review_status": "REVIEWED", "availability": "RUNTIME"
    },
    {
      "entry_id": "BIOME:biomeswevegone:red_rock_peaks",
      "title": "Picos de Rocha Vermelha",
      "summary": {
        "text": "Picos de Rocha Vermelha é um bioma do Overworld registrado por Oh The Biomes We've Gone com o ID biomeswevegone:red_rock_peaks.",
        "sources": [
          {"type": "RUNTIME", "ref": "biomeswevegone:biome/biomeswevegone:red_rock_peaks"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"},
