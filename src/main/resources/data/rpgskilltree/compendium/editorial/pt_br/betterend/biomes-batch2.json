      "summary": {
        "text": "Madeiras Lanterna é um bioma do End registrado por BetterEnd: New Dawn com o ID betterend:lantern_woods.",
        "sources": [
          {"type": "RUNTIME", "ref": "betterend:biome/betterend:lantern_woods"},
