      "entry_id": "BIOME:betterend:flower_islets",
      "title": "Flower Islets",
      "summary": {
        "text": "Flower Islets é um bioma do End registrado por BetterEnd: New Dawn como betterend:flower_islets. O provider não fornece uma chave de nome para este bioma nos assets pt-BR nem en-US congelados; o título editorial é um fallback legível derivado de FlowerIsletsBiome e do registry path oficial.",
        "sources": [
          {"type": "RUNTIME", "ref": "betterend:biome/betterend:flower_islets"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterEnd-New-Dawn/blob/360b6fea407befdcf9aab7f771cad5586cbfb826/src/main/java/org/betterx/betterend/registry/EndBiomes.java"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterEnd-New-Dawn/blob/360b6fea407befdcf9aab7f771cad5586cbfb826/src/main/resources/assets/betterend/lang/pt_br.json"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterEnd-New-Dawn/blob/360b6fea407befdcf9aab7f771cad5586cbfb826/src/main/resources/assets/betterend/lang/en_us.json"}
        ]
      },
      "sections": {
        "worldgen": {
          "text": "O datapack Wover inclui este bioma em `is_end/small_island`. O ID não aparece no conjunto registrado por `registerBiomeToggles()` no commit congelado; a ficha não converte a categoria de placement em tamanho, altitude, frequência ou geometria fixa.",
          "sources": [
            {"type": "DATAPACK", "ref": "data/wover/tags/worldgen/biome/is_end/small_island.json"},
            {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterEnd-New-Dawn/blob/360b6fea407befdcf9aab7f771cad5586cbfb826/src/main/java/org/betterx/betterend/registry/EndBiomes.java"}
          ]
        }
      },
      "references": [],
      "review_status": "REVIEWED",
      "availability": "RUNTIME"
    },
