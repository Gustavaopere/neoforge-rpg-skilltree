      "entry_id": "BIOME:betternether:wart_forest",
      "title": "Wart Forest",
      "summary": {
        "text": "Wart Forest é um bioma do Nether registrado por BetterNether: New Dawn com o ID betternether:wart_forest. O título preserva exatamente o valor fornecido pelo asset pt-BR do provider.",
        "sources": [
          {"type": "RUNTIME", "ref": "betternether:biome/betternether:wart_forest"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterNether-New-Dawn/blob/543127cab48b1ecb0017fee4222af25e0583e185/src/main/java/org/betterx/betternether/registry/NetherBiomes.java"},
