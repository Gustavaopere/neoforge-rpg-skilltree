        ]
      },
      "sections": {
        "worldgen": {
          "text": "O registro oficial classifica este bioma como floresta conífera e o inclui no tag de estrutura da Vila Pumpkin Patch do próprio BWG. O tag expressa elegibilidade de worldgen, não presença garantida.",
          "sources": [{"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"}]
        }
      },
      "references": [], "review_status": "REVIEWED", "availability": "RUNTIME"
    },
