      "entry_id": "BIOME:biomeswevegone:cika_woods",
      "title": "Bosque de Cika",
      "summary": {
        "text": "Bosque de Cika é um bioma do Overworld registrado por Oh The Biomes We've Gone com o ID biomeswevegone:cika_woods.",
        "sources": [
          {"type": "RUNTIME", "ref": "biomeswevegone:biome/biomeswevegone:cika_woods"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"},
