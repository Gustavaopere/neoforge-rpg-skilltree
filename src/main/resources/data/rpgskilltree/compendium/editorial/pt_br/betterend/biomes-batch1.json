        ]
      },
      "sections": {"worldgen": {"text": "O datapack Wover do provider inclui este bioma na categoria de terreno do End (`is_end/land`). O BetterEnd também registra este ID entre os biomas configuráveis; a ocorrência concreta continua dependente das configurações e do worldgen ativos.", "sources": [{"type": "DATAPACK", "ref": "data/wover/tags/worldgen/biome/is_end/land.json"}, {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterEnd-New-Dawn/blob/360b6fea407befdcf9aab7f771cad5586cbfb826/src/main/java/org/betterx/betterend/registry/EndBiomes.java"}]}},
      "references": [], "review_status": "REVIEWED", "availability": "RUNTIME"
    },
    {
