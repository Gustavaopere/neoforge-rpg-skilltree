      "entry_id": "BIOME:betterend:crystal_mountains",
      "title": "Montanhas de Cristal",
      "summary": {
        "text": "Montanhas de Cristal é um bioma do End registrado por BetterEnd: New Dawn com o ID betterend:crystal_mountains.",
        "sources": [
          {"type": "RUNTIME", "ref": "betterend:biome/betterend:crystal_mountains"},
