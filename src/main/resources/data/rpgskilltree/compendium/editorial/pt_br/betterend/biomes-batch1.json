    },
    {
      "entry_id": "BIOME:betterend:dragon_graveyards",
      "title": "Cemitérios de Dragão",
      "summary": {
        "text": "Cemitérios de Dragão é um bioma do End registrado por BetterEnd: New Dawn com o ID betterend:dragon_graveyards.",
