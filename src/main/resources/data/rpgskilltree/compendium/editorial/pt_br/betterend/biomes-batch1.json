      "entry_id": "BIOME:betterend:amber_land",
      "title": "Terras de Âmbar",
      "summary": {
        "text": "Terras de Âmbar é um bioma do End registrado por BetterEnd: New Dawn com o ID betterend:amber_land.",
        "sources": [
          {"type": "RUNTIME", "ref": "betterend:biome/betterend:amber_land"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterEnd-New-Dawn/blob/360b6fea407befdcf9aab7f771cad5586cbfb826/src/main/java/org/betterx/betterend/registry/EndBiomes.java"},
