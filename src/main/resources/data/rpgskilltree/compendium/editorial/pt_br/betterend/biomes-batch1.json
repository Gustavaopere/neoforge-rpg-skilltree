    {
      "entry_id": "BIOME:betterend:chorus_forest",
      "title": "Floresta de Choros",
      "summary": {
        "text": "Floresta de Choros é um bioma do End registrado por BetterEnd: New Dawn com o ID betterend:chorus_forest.",
        "sources": [
          {"type": "RUNTIME", "ref": "betterend:biome/betterend:chorus_forest"},
