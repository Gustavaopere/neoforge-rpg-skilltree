        ]
      },
      "sections": {"worldgen": {"text": "O registro oficial do provider classifica este bioma como selva. A ocorrência concreta continua dependente do worldgen e das configurações ativas.", "sources": [{"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"}]}},
