      "entry_id": "BIOME:biomeswevegone:jacaranda_jungle",
      "title": "Selva de Jacarandá",
      "summary": {
        "text": "Selva de Jacarandá é um bioma do Overworld registrado por Oh The Biomes We've Gone com o ID biomeswevegone:jacaranda_jungle.",
        "sources": [
          {"type": "RUNTIME", "ref": "biomeswevegone:biome/biomeswevegone:jacaranda_jungle"},
