      "entry_id": "BIOME:biomeswevegone:aspen_boreal",
      "title": "Álamo Boreal",
      "summary": {
        "text": "Álamo Boreal é um bioma do Overworld registrado por Oh The Biomes We've Gone com o ID biomeswevegone:aspen_boreal.",
