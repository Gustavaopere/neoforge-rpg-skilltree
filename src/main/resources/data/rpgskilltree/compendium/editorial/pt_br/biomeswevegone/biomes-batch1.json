      "entry_id": "BIOME:biomeswevegone:araucaria_savanna",
      "title": "Savana de Araucária",
      "summary": {
        "text": "Savana de Araucária é um bioma do Overworld registrado por Oh The Biomes We've Gone com o ID biomeswevegone:araucaria_savanna.",
        "sources": [
          {"type": "RUNTIME", "ref": "biomeswevegone:biome/biomeswevegone:araucaria_savanna"},
