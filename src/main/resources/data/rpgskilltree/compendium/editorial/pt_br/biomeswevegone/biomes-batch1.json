      "entry_id": "BIOME:biomeswevegone:allium_shrubland",
      "title": "Matagal de Alho-silvestre",
      "summary": {
        "text": "Matagal de Alho-silvestre é um bioma do Overworld registrado por Oh The Biomes We've Gone com o ID biomeswevegone:allium_shrubland.",
        "sources": [
          {"type": "RUNTIME", "ref": "biomeswevegone:biome/biomeswevegone:allium_shrubland"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Potion-Studios/Oh-The-Biomes-Weve-Gone/blob/3040862ddd02c2487c946cac2803502e59508062/Common/src/main/java/net/potionstudios/biomeswevegone/world/level/levelgen/biome/BWGBiomes.java"},
