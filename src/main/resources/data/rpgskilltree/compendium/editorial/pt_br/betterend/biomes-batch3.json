    {
      "entry_id": "BIOME:betterend:painted_mountains",
      "title": "Montanhas Pintadas",
      "summary": {
        "text": "Montanhas Pintadas é um bioma do End registrado por BetterEnd: New Dawn com o ID betterend:painted_mountains. No registry oficial, sua chave declara Terras Devastadas (`betterend:dust_wastelands`) como bioma-base associado.",
        "sources": [
          {"type": "RUNTIME", "ref": "betterend:biome/betterend:painted_mountains"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterEnd-New-Dawn/blob/360b6fea407befdcf9aab7f771cad5586cbfb826/src/main/java/org/betterx/betterend/registry/EndBiomes.java"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterEnd-New-Dawn/blob/360b6fea407befdcf9aab7f771cad5586cbfb826/src/main/resources/assets/betterend/lang/pt_br.json"}
        ]
      },
      "sections": {
        "worldgen": {
          "text": "O provider registra este bioma em `IS_END_LAND`, e o datapack Wover o inclui em `is_end/land`. O ID também participa de `registerBiomeToggles()`. A associação a Terras Devastadas e a categoria de land não são convertidas em altura, geometria, frequência, chance ou posição fixa.",
          "sources": [
            {"type": "DATAPACK", "ref": "data/wover/tags/worldgen/biome/is_end/land.json"},
            {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterEnd-New-Dawn/blob/360b6fea407befdcf9aab7f771cad5586cbfb826/src/main/java/org/betterx/datagen/betterend/worldgen/EndBiomesProvider.java"},
            {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterEnd-New-Dawn/blob/360b6fea407befdcf9aab7f771cad5586cbfb826/src/main/java/org/betterx/betterend/registry/EndBiomes.java"}
          ]
        }
      },
      "references": [],
      "review_status": "REVIEWED",
      "availability": "RUNTIME"
    },
