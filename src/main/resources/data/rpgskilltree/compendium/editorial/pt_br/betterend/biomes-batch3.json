      "entry_id": "BIOME:betterend:empty_end_cave",
      "title": "Caverna do End Vazia",
      "summary": {
        "text": "Caverna do End Vazia é um bioma de caverna do End registrado por BetterEnd: New Dawn com o ID betterend:empty_end_cave.",
        "sources": [
          {"type": "RUNTIME", "ref": "betterend:biome/betterend:empty_end_cave"},
          {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterEnd-New-Dawn/blob/360b6fea407befdcf9aab7f771cad5586cbfb826/src/main/java/org/betterx/betterend/registry/EndBiomes.java"},
