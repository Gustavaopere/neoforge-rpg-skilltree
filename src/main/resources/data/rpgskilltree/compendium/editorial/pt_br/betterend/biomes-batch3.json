        ]
      },
      "sections": {
        "worldgen": {
          "text": "O provider registra este ID com `EndTags.IS_END_CAVE`, e o datapack BetterEnd o inclui em `is_end_cave`. O ID também integra `registerBiomeToggles()`. A classificação cave não fixa em prosa altitude, profundidade, tamanho, frequência ou distribuição.",
          "sources": [
            {"type": "DATAPACK", "ref": "data/betterend/tags/worldgen/biome/is_end_cave.json"},
            {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterEnd-New-Dawn/blob/360b6fea407befdcf9aab7f771cad5586cbfb826/src/main/java/org/betterx/datagen/betterend/worldgen/EndBiomesProvider.java"},
