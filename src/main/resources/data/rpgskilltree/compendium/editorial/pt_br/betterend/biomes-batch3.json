      "summary": {
        "text": "Caverna Aurora Vazia é um bioma de caverna do End registrado por BetterEnd: New Dawn com o ID betterend:empty_aurora_cave.",
        "sources": [
          {"type": "RUNTIME", "ref": "betterend:biome/betterend:empty_aurora_cave"},
