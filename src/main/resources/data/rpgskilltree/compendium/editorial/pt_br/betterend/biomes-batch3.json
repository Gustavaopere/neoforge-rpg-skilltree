        ]
      },
      "sections": {
        "worldgen": {
          "text": "O provider registra este ID com `EndTags.IS_END_CAVE`, o datapack BetterEnd o inclui em `is_end_cave` e o ID participa de `registerBiomeToggles()`. A ficha não deduz conteúdo, densidade, tamanho, profundidade ou frequência apenas do título localizado.",
          "sources": [
            {"type": "DATAPACK", "ref": "data/betterend/tags/worldgen/biome/is_end_cave.json"},
            {"type": "OFFICIAL_CODE", "ref": "https://github.com/Reijin2312/BetterEnd-New-Dawn/blob/360b6fea407befdcf9aab7f771cad5586cbfb826/src/main/java/org/betterx/datagen/betterend/worldgen/EndBiomesProvider.java"},
